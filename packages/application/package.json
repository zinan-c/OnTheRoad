{
  "name": "@on-the-road/application",
  "private": true,
  "type": "module",
  "exports": {
    "./idempotency": {
      "types": "./src/idempotency/index.ts",
      "default": "./dist/idempotency/index.js"
    },
    "./location": {
      "types": "./src/location/adjust-coordinates.ts",
      "default": "./dist/location/adjust-coordinates.js"
    },
    "./import": {
      "types": "./src/import/contracts.ts",
      "default": "./dist/import/contracts.js"
    },
    "./import/commit": {
      "types": "./src/import/commit.ts",
      "default": "./dist/import/commit.js"
    },
    "./export": {
      "types": "./src/export/contracts.ts",
      "default": "./dist/export/contracts.js"
    },
    "./export/snapshot": {
      "types": "./src/export/snapshot.ts",
      "default": "./dist/export/snapshot.js"
    }
  },
  "scripts": {
    "lint": "tsc6 -p tsconfig.json",
    "typecheck": "tsc6 -p tsconfig.json",
    "unit": "vitest run --passWithNoTests",
    "build": "tsc6 -p tsconfig.build.json"
  }
}
