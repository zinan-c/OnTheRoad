{
  "name": "@on-the-road/config",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/env.ts",
      "default": "./dist/env.js"
    },
    "./env": {
      "types": "./src/env.ts",
      "default": "./dist/env.js"
    },
    "./reference-data": {
      "types": "./src/reference-data.mjs",
      "default": "./src/reference-data.mjs"
    }
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc6 -p tsconfig.json",
    "unit": "vitest run",
    "build": "tsc6 -p tsconfig.build.json"
  }
}
