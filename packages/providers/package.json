{
  "name": "@on-the-road/providers",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./geocoding": {
      "types": "./src/geocoding/index.ts",
      "default": "./dist/geocoding/index.js"
    },
    "./static-map": {
      "types": "./src/static-map/manifest.ts",
      "default": "./dist/static-map/manifest.js"
    },
    "./static-map/renderer": {
      "types": "./src/static-map/renderer.ts",
      "default": "./dist/static-map/renderer.js"
    },
    "./coordinates": {
      "types": "./src/coordinates/index.ts",
      "default": "./dist/coordinates/index.js"
    },
    "./coordinates/gcj02": {
      "types": "./src/coordinates/gcj02.ts",
      "default": "./dist/coordinates/gcj02.js"
    },
    "./directions": {
      "types": "./src/directions/index.ts",
      "default": "./dist/directions/index.js"
    },
    "./static-map/amap": {
      "types": "./src/static-map/amap.ts",
      "default": "./dist/static-map/amap.js"
    }
  },
  "scripts": {
    "lint": "tsc6 -p tsconfig.json",
    "typecheck": "tsc6 -p tsconfig.json",
    "unit": "vitest run",
    "build": "tsc6 -p tsconfig.build.json"
  }
