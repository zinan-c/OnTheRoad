# Local-only contract shared by the Native and Compose tracks.
# Never reuse these credentials outside a developer machine.
POSTGRES_DB=on_the_road_local
POSTGRES_USER=otr_local_app
POSTGRES_PASSWORD=otr_local_pg_7f3a9c2e
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql://otr_local_app:otr_local_pg_7f3a9c2e@127.0.0.1:5432/on_the_road_local

REDIS_PASSWORD=otr_local_redis_4d8b1e6c
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://default:otr_local_redis_4d8b1e6c@127.0.0.1:6379/0

MINIO_ROOT_USER=otr_local_admin
MINIO_ROOT_PASSWORD=otr_local_minio_6c2f9a4d
MINIO_BUCKET=on-the-road-local
MINIO_HOST=127.0.0.1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=local
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY=otr_local_admin
S3_SECRET_KEY=otr_local_minio_6c2f9a4d

CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_REQUIRED=true

# Optional absolute binary paths. When empty, the Native Track searches PATH.
POSTGRES_BIN=
INITDB_BIN=
PG_CTL_BIN=
PG_CONFIG_BIN=
CREATEDB_BIN=
PSQL_BIN=
REDIS_SERVER_BIN=
REDIS_CLI_BIN=
MINIO_BIN=
MC_BIN=
CLAMD_BIN=
CLAMDSCAN_BIN=
CLAMSCAN_BIN=

# Override only when signatures are maintained outside the project runtime.
CLAMAV_DATABASE_DIR=
