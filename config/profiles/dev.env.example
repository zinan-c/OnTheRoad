# Development profile: local/native services only. Docker is not checked.
OTR_RUNTIME_PROFILE=dev
NODE_ENV=development
OTR_DEV_POSTGRES_MODE=native
OTR_DEV_REDIS_MODE=native
OTR_DEV_MINIO_MODE=native
OTR_DEV_CLAMAV_MODE=native
OTR_DEV_API_MODE=native
OTR_DEV_WEB_MODE=native
OTR_DEV_WORKER_MODE=native

# Application connection contract. Copy to config/profiles/dev.env and fill
# these values for the current native or QA-like local stack.
# OTR_ENV_DATABASE_URL=
# OTR_ENV_REDIS_URL=
# OTR_ENV_OBJECT_STORAGE_ENDPOINT=
# OTR_ENV_OBJECT_STORAGE_ACCESS_KEY=
# OTR_ENV_OBJECT_STORAGE_SECRET_KEY=
# OTR_ENV_OBJECT_STORAGE_BUCKET=
# OTR_ENV_OBJECT_STORAGE_REGION=local
# OTR_ENV_CLAMAV_HOST=127.0.0.1
# OTR_ENV_CLAMAV_PORT=3310
# OTR_ENV_SESSION_SECRET=
