# Release/prod profile: release gates are explicit and Docker/IdP checks belong here.
OTR_RUNTIME_PROFILE=release
NODE_ENV=production
OTR_RELEASE_GATE=1
OTR_RELEASE_DOCKER_GATE=1
OTR_RELEASE_STAGING_IDP_GATE=1

# Deployment-injected only; use domain-restricted public tiles and a separate
# server-only Permanent Geocoding token. Do not place real values in this file.
# MAP_PROFILE=international_primary
# MAPBOX_PUBLIC_TOKEN=pk.<domain-restricted-public-token>
# MAPBOX_GEOCODING_TOKEN=sk.<server-only-permanent-token>
# OTR_MAP_DEFAULT_LAYER=mapbox-streets
# OTR_MAPBOX_TILE_SIZE=512
# OTR_MAPBOX_MAX_ZOOM=22
# OTR_MAPBOX_LIVE_SMOKE=0
