# QA profile. Copy to config/profiles/qa.env and choose each service mode.
# The runner never starts Docker implicitly; container mode is an explicit QA choice.
OTR_RUNTIME_PROFILE=qa
NODE_ENV=development
OTR_QA_POSTGRES_MODE=native
OTR_QA_REDIS_MODE=native
OTR_QA_MINIO_MODE=native
OTR_QA_CLAMAV_MODE=native
OTR_QA_API_MODE=native
OTR_QA_WEB_MODE=native
OTR_QA_WORKER_MODE=native

# Set the normal application connection variables below for the selected services.
# OTR_ENV_DATABASE_URL=
# OTR_ENV_REDIS_URL=
# OTR_ENV_OBJECT_STORAGE_ENDPOINT=
# OTR_ENV_OBJECT_STORAGE_ACCESS_KEY=
# OTR_ENV_OBJECT_STORAGE_SECRET_KEY=
# OTR_ENV_OBJECT_STORAGE_BUCKET=
# OTR_ENV_OBJECT_STORAGE_REGION=local
# OTR_ENV_CLAMAV_HOST=
# OTR_ENV_CLAMAV_PORT=3310
# OTR_ENV_SESSION_SECRET=

# Select one explicit map deployment profile for a QA run. Never commit tokens.
# MAP_PROFILE=international_primary
# MAPBOX_PUBLIC_TOKEN=pk.<domain-restricted-public-token>
# MAPBOX_GEOCODING_TOKEN=sk.<server-only-permanent-token>
# OTR_MAP_DEFAULT_LAYER=mapbox-streets
# OTR_MAPBOX_TILE_SIZE=512
# OTR_MAPBOX_MAX_ZOOM=22
# OTR_MAPBOX_LIVE_SMOKE=0
