# QA profile. Copy to config/profiles/qa.env and choose each service mode.
# The runner never starts Docker implicitly; container mode is an explicit QA choice.
OTR_RUNTIME_PROFILE=qa
NODE_ENV=development
OTR_QA_POSTGRES_MODE=native
OTR_QA_REDIS_MODE=native
OTR_QA_MINIO_MODE=native
OTR_QA_CLAMAV_MODE=native
OTR_QA_API_MODE=native
OTR_QA_WEB_MODE=native
OTR_QA_WORKER_MODE=native

# Set the normal application connection variables below for the selected services.
# DATABASE_URL=
# REDIS_URL=
# OBJECT_STORAGE_ENDPOINT=
# OBJECT_STORAGE_ACCESS_KEY=
# OBJECT_STORAGE_SECRET_KEY=
# OBJECT_STORAGE_BUCKET=
# CLAMAV_HOST=
# CLAMAV_PORT=3310
