{
  "name": "@on-the-road/web",
  "private": true,
  "type": "module",
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@on-the-road/application": "workspace:*",
