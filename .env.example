# Runtime
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
API_BASE_URL=http://localhost:3001/api/v1
WEB_PORT=3000
API_PORT=3001

# Local PostGIS / Redis
DATABASE_URL=postgresql://on_the_road:local-only@localhost:5432/on_the_road
REDIS_URL=redis://localhost:6379

# Local MinIO / ClamAV. These values are intentionally development-only.
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=otr-local-access
OBJECT_STORAGE_SECRET_KEY=otr-local-secret-change-me
OBJECT_STORAGE_BUCKET=on-the-road-dev
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
SESSION_SECRET=local-session-secret-change-me-32-bytes

# Offline-first map profile. Online search requires an explicit Provider key.
MAP_PROFILE=fixture
MAP_AUTOCOMPLETE_ENABLED=false
MAP_EXPLICIT_SEARCH_ENABLED=false
AMAP_API_KEY=
OTR_HERE_API_KEY=
OTR_HERE_GEOCODE_ENDPOINT=https://geocode.search.hereapi.com/v1/geocode
OTR_HERE_DISCOVER_ENDPOINT=https://discover.search.hereapi.com/v1/discover
OTR_HERE_REVERSE_ENDPOINT=https://revgeocode.search.hereapi.com/v1/revgeocode
