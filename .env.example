# Runtime
NODE_ENV=development
OTR_RUNTIME_PROFILE=dev
APP_ORIGIN=http://127.0.0.1:18100
API_BASE_URL=http://127.0.0.1:18101/api/v1
WEB_PORT=18100
API_PORT=18101

# Local PostGIS / Redis
OTR_ENV_DATABASE_URL=postgresql://on_the_road:local-only@localhost:5432/on_the_road
OTR_ENV_REDIS_URL=redis://localhost:6379

# Local MinIO / ClamAV. These values are intentionally development-only.
OTR_ENV_OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OTR_ENV_OBJECT_STORAGE_ACCESS_KEY=otr-local-access
OTR_ENV_OBJECT_STORAGE_SECRET_KEY=otr-local-secret-change-me
OTR_ENV_OBJECT_STORAGE_BUCKET=on-the-road-dev
OTR_ENV_OBJECT_STORAGE_REGION=local
OTR_ENV_CLAMAV_HOST=localhost
OTR_ENV_CLAMAV_PORT=3310
OTR_ENV_SESSION_SECRET=local-session-secret-change-me-32-bytes

# CI and offline regression default. Local .env can override this to an online profile.
MAP_PROFILE=fixture
MAP_AUTOCOMPLETE_ENABLED=false
MAP_EXPLICIT_SEARCH_ENABLED=false
AMAP_API_KEY=
OTR_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OTR_NOMINATIM_USER_AGENT=OnTheRoad/0.0.0-configure-contact
OTR_NOMINATIM_CONTACT=replace-with-your-contact@example.com
OTR_NOMINATIM_TIMEOUT_MS=5000
OTR_NOMINATIM_RATE_LIMIT_RPS=1
OTR_NOMINATIM_CACHE_TTL_SECONDS=86400
